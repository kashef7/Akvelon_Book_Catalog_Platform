#Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

#Copy .csproj files and restore
COPY App_PL/App_PL.csproj App_PL/
COPY App_BLL/App_BLL.csproj App_BLL/
COPY App_DAL/App_DAL.csproj App_DAL/
COPY App_Common/App_Common.csproj App_Common/
RUN dotnet restore App_PL/App_PL.csproj

#Copy src files and publish
COPY App_PL/ App_PL/
COPY App_BLL/ App_BLL/
COPY App_DAL/ App_DAL/
COPY App_Common/ App_Common/
RUN dotnet publish App_PL/App_PL.csproj -c Release -o /app --no-restore

#Stage 2: Run time
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

USER $APP_UID

ENTRYPOINT ["dotnet", "App_PL.dll"]


